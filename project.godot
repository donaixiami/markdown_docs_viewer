; Engine configuration file.
; Development project for the Markdown Docs Viewer addon.

config_version=5

[application]

config/name="Markdown Docs Viewer"
config/features=PackedStringArray("4.7", "GL Compatibility")

[editor_plugins]

enabled=PackedStringArray("res://addons/markdown_docs_viewer/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
